%% claudenotes.sty --- backwards-compatibility shim.
%% Part of the latex-todonotes skill (https://github.com/postylem/latex-todonotes).
%%
%% Everything now lives in agentnotes.sty, which supports any number of agents
%% per paper.  This file exists so that papers set up before that refactor keep
%% building with no edit: it loads the core and instantiates Claude, which is
%% what \usepackage{claudenotes} used to do on its own.
%%
%% New papers should prefer the explicit form, which reads the same and leaves
%% room for a second agent:
%%   \usepackage{mytodonotes}
%%   \usepackage{agentnotes}
%%   \newagent{claude}
%%
%% ClaudeColor, ClaudeTextColor and ClaudeNoteBG are kept as aliases of the
%% per-agent colorlets, because papers re-tint Claude by redefining them.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{claudenotes}[2026/09/14 v2.0 compatibility shim over agentnotes]
\RequirePackage{agentnotes}

\newagent{claude}

\colorlet{ClaudeColor}{agentcolor-claude}
\colorlet{ClaudeTextColor}{agenttext-claude}
\colorlet{ClaudeNoteBG}{agentbg-claude}

\endinput
