%% claudenotes.sty --- Claude Code todonotes integration (owner-tagged)
%% Part of the latex-todonotes skill (https://github.com/postylem/latex-todonotes).
%% Load AFTER mytodonotes.sty (needs its \note macro):
%%   \usepackage{mytodonotes}
%%   \usepackage{claudenotes}
%%
%% Macros:
%%   \claude[jac]{...}        margin note, labeled "claude@jac"
%%   \Claude[jac]{...}        inline variant
%%   \claudeSuggest[jac]{...} small inline text suggestion, in Claude purple
%%   \claudechange[jac]{...}  Claude-authored replacement text (owner arg is
%%                            provenance only; renders in Claude purple)
%%   \begin{ClaudeSuggest}[jac]...\end{ClaudeSuggest}  block suggestion
%%                            (purple changebar; small "claude@jac" label
%%                             with the @owner part in the owner's accent)
%%
%% All Claude notes share the Claude purple; the OWNER shows as an accent:
%% the note's frame and leader line take a darkened notecolor-<owner>.
%% Authors set up nothing Claude-specific: \claude[<name>] finds the color
%% `notecolor-<name>` that the author defined next to their own note macros
%% in the document preamble, i.e. the three-line pattern
%%   \colorlet{notecolor-jac}{red!40}
%%   \newcommand{\jac}[2][]{\note[#1]{jac}{notecolor-jac}{#2}}
%%   \newcommand{\Jac}[2][]{\jac[inline,#1]{#2}}
%% An owner without a notecolor (or an omitted owner) falls back to plain
%% purple, so an untabulated owner never breaks the build.
%%
%% Per-paper re-tinting: redefine ClaudeColor and ClaudeNoteBG after loading.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{claudenotes}[2026/08/14 v1.7 owner-tagged Claude todonotes]
\RequirePackage{mytodonotes}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}

\definecolor{ClaudeColor}{RGB}{110,60,160}   % claude purple
\colorlet{ClaudeNoteBG}{ClaudeColor!17}      % claude note background

\@namedef{claude@who@claude}{claude}
\newcommand{\claude@setaccent}[1]{%
  \@ifundefinedcolor{notecolor-#1}%
    {\colorlet{claude-accent}{ClaudeColor}}%
    {\colorlet{claude-accent}{notecolor-#1!75!black}}}
% The label, everywhere it appears: "claude" in Claude purple, "@owner" in the
% owner's accent.  Callers must run \claude@setaccent{#1} in the same group.
\newcommand{\claude@who}[1]{%
  \textcolor{ClaudeColor}{claude}%
  \ifcsname claude@who@#1\endcsname\else\textcolor{claude-accent}{@#1}\fi}
\NewDocumentCommand{\claude}{O{claude} O{} +m}{%
  \claude@setaccent{#1}%
  \note[bordercolor=claude-accent,linecolor=claude-accent,#2]%
    {\claude@setaccent{#1}\claude@who{#1}}{ClaudeNoteBG}{#3}}
\NewDocumentCommand{\Claude}{O{claude} O{} +m}{%
  \claude[#1][inline,#2]{#3}}
\NewDocumentCommand{\claudechange}{O{claude} +m}{%
  \textcolor{ClaudeColor}{#2}}
\NewDocumentCommand{\claudeSuggest}{O{claude} +m}{%
  {\claude@setaccent{#1}\color{ClaudeColor}\textbf{\claude@who{#1}}: #2}}
% Reply inside another author's note, labeled like the note headers above.
% Routed through \response so it inherits that macro's rule and spacing.
\NewDocumentCommand{\claudeResponse}{O{claude}}{%
  \response{\claude@setaccent{#1}\claude@who{#1}}}

% Block suggestions: purple changebar and text, headed by a small bold label
% "claude@<owner>" with the @<owner> part in the owner's accent color
% (default owner shows just "claude"; unknown owners fall back to purple)
\newlength{\claude@labelgap}\setlength{\claude@labelgap}{9pt}  % room above the first line for the label
\newcommand{\claude@blocklabel}[1]{%
  {\scriptsize\bfseries\claude@setaccent{#1}\claude@who{#1}}}
\NewTColorBox{ClaudeSuggest}{O{claude}}{
  blanker,
  breakable,
  code={\claude@setaccent{#1}},
  borderline west={3pt}{0pt}{ClaudeColor},
  left=8pt,
  before skip=10pt,
  after skip=10pt,
  % The label rides in an overlay rather than in the text flow, so it costs no
  % vertical space of its own; `top` is the whole gap between it and the first
  % line.  `unbroken and first` keeps it off continuation pages.
  top=\claude@labelgap,
  overlay unbroken and first={%
    \node[anchor=north west, inner sep=0pt, xshift=8pt, yshift=-1pt]
      at (frame.north west) {\claude@blocklabel{#1}};},
  % colupper, not \color in before upper: the latter is applied once and is lost
  % where a breakable box continues onto the next page.
  colupper=ClaudeColor,
  before upper={\nobreak\ignorespaces},
  after={\noindent}
}

\endinput
