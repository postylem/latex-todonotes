%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TODONOTE CONFIGURATION
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mytodonotes}[2026/08/18 v1.5 todonotes configuration]
\RequirePackage[textsize=scriptsize]{todonotes} % [disable]
\RequirePackage[most]{tcolorbox}   % breakable inline notes
\tikzset{
  notestyleraw/.append style={
    rounded corners=0pt,
    inner sep=3pt,
    line width=0.9pt,  % frame stays enabled; \note sets bordercolor = fill,
                       % so plain notes look flat and only notes that override
                       % bordercolor (e.g. \claude's owner accent) show a frame
  }
}
\makeatletter
\newcommand*\iftodonotes{\if@todonotes@disabled\expandafter\@secondoftwo\else\expandafter\@firstoftwo\fi}  % defines \iftodonotes{<true>}{<false>}, thanks to \makeatother
\newcommand{\noindentaftertodo}{\iftodonotes{\noindent}{}}

% Paragraphs inside notes follow the document's paragraph style.  Note bodies
% are typeset in minipage-like boxes, which zero both \parindent and \parskip,
% so multi-paragraph notes lose whichever separator the document uses (the
% indent by default; the skip under \usepackage{parskip}).  Capture the
% document's values once it is fully set up, and let \noteparstyle restore
% them inside a note body.
\newlength{\note@parindent}
\newlength{\note@parskip}
\AtBeginDocument{%
  \setlength{\note@parindent}{\parindent}%
  \setlength{\note@parskip}{\parskip}}
% A run-in heading (\paragraph) as the first thing in a minipage-like box
% clobbers the box's \everypar before it can clear \if@minipage, and the
% kernel's paragraph handling (ltpara) cancels the auto-inserted \parskip
% glue with -\parskip while that flag is true -- so every later paragraph in
% the box loses its parskip.  Clearing the flag at the first paragraph's
% para/begin hook reproduces what the box's own \everypar would have done,
% at the same effective timing: the flag still suppresses \parskip at the
% box top (that decision predates the hook), and is gone afterwards.
\newcommand{\notefixminipageflag}{%
  \AddToHookNext{para/begin}{\global\@minipagefalse}}
\newcommand{\noteparstyle}{%
  \setlength{\parindent}{\note@parindent}%
  \setlength{\parskip}{\note@parskip}%
  \notefixminipageflag}

% Inline notes break across pages.  todonotes typesets [inline] notes as a
% single TikZ node, which cannot split, so a long inline comment overflows its
% page; \note therefore routes inline notes to a breakable tcolorbox styled to
% match (same fill, same 0.9pt frame, same text size and padding).  Any other
% todonotes options passed alongside `inline` are ignored on this path.
%
% A package may override the frame color of the NEXT inline note with
% \noteframecolor{<color>} (claudenotes uses this for the owner accent); the
% override resets after every \note.
\def\note@frameoverride{}
\newcommand{\noteframecolor}[1]{\def\note@frameoverride{#1}}
\newcommand{\note@inline}[3]{% #1 = name, #2 = fill color, #3 = body
  \ifx\note@frameoverride\@empty
    \colorlet{note@frame}{#2}%
  \else
    \colorlet{note@frame}{\note@frameoverride}%
  \fi
  \begin{tcolorbox}[breakable, sharp corners, boxrule=0.9pt,
      colback=#2, colframe=note@frame,
      left=3pt, right=3pt, top=3pt, bottom=3pt,
      before skip=\medskipamount, after skip=\medskipamount]
    \scriptsize\noteparstyle\noindent\textbf{#1}: #3%
  \end{tcolorbox}}
\newcommand{\note}[4][]{%
  \in@{inline}{#1}%
  \ifin@
    \iftodonotes{\note@inline{#2}{#3}{#4}}{}%
  \else
    \todo[color=#3,bordercolor=#3,caption={},#1]{\noteparstyle\textbf{#2}: #4}%
  \fi
  \def\note@frameoverride{}}
% \response{<name>} starts a new author's reply within someone else's note.
% The reply is the first paragraph of its own little section: never indented,
% while later paragraphs by the same author separate per \noteparstyle.  The
% divider rule does the separating between authors, so it gets a fixed 3pt on
% each side with no \parskip contribution -- notes are cramped, and rule plus
% skip would be paying twice.  TeX still re-inserts \parskip when the reply
% paragraph starts, so the lower \vspace pre-subtracts the whole thing.
\newcommand{\response}[1]{%
  \par
  \vspace{3pt}%
  \hrule
  \nobreak
  \vspace{\glueexpr 3pt-\parskip\relax}%
  \noindent\textbf{#1:}}
\newcommand{\notewho}[3][]{\note[#1]{#2}{blue!40}{#3}}     % for other commenters: specify author name in first required arg
\newcommand{\Notewho}[3][]{\notewho[inline,#1]{#2}{#3}\noindentaftertodo}

